{
  "name": "agent-mesh",
  "displayName": "Agent Mesh",
  "version": "1.0.0",
  "description": "Background multi-AI orchestration hub. Bind custom reasoning APIs, local Codex projects, multi-instance desktop assistants, and optional Antigravity projects per workspace for parallel collaboration with paginated history.",
  "icon": "icon.svg",
  "engines": {
    "cage": ">=0.2.0"
  },
  "kind": "host",
  "platforms": [
    "windows",
    "darwin",
    "linux"
  ],
  "permissions": [
    "files",
    "commands",
    "network"
  ],
  "categories": [
    "developer",
    "productivity"
  ],
  "contributes": {
    "mcpServers": [
      {
        "id": "mesh",
        "command": [
          "python3",
          "-X",
          "utf8",
          "server.py",
          "--project-dir",
          "${PROJECT_DIR}"
        ]
      }
    ],
    "views": [
      {
        "id": "panel",
        "title": "Agent Mesh",
        "icon": "icon.svg",
        "entry": "view/index.html",
        "server": "mesh"
      }
    ]
  }
}
